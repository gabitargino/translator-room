# translator-room: scripts executed inside Linux containers must keep LF line
# endings even on Windows checkouts with core.autocrlf=true; with CRLF the
# container fails with "/bin/sh^M: not found".
*.sh text eol=lf
Dockerfile text eol=lf
# Caddyfile e página do certificado são lidos dentro de um contêiner Linux.
caddy/* text eol=lf
# PowerShell 5.1 precisa do BOM UTF-8 para ler acentos; CRLF é o padrão dele.
*.ps1 text eol=crlf
